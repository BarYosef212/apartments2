# Server
PORT=4000
MONGO_URI=
SESSION_SECRET=
JWT_SECRET=

# Optional: n8n/agent chat endpoint used by POST /apartments/agent
AGENT_URL=

# Yad2 scraper (run `npx playwright install chromium` once)
PLAYWRIGHT_PROFILE_DIR=.playwright-profile
HEADLESS=true

# Where uploaded site images/videos are stored (default: back/uploads)
UPLOADS_DIR=

# Outgoing email for website forms (e.g. Gmail: smtp.gmail.com, port 465, an App Password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Sender shown on the email; defaults to SMTP_USER
MAIL_FROM=
# Public site address, for links to listings in form emails (e.g. https://example.co.il)
SITE_URL=

# Key for encrypting secrets saved from the admin (e.g. SMTP password). Defaults to JWT_SECRET;
# set it so rotating JWT_SECRET does not invalidate saved passwords.
SETTINGS_SECRET=
